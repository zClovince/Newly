{
  "manifest_version": 3,
  "name": "Newly",
  "version": "1.0.0",
  "description": "Newly \u2014 a calm, glassy new tab page with weather, clock, shortcuts, quotes and a wallpaper you choose. Works in Chrome, Brave, Edge and Firefox.",
  "permissions": [],
  "host_permissions": [
    "https://www.google.com/s2/favicons/*",
    "https://*.gstatic.com/*",
    "https://upload.wikimedia.org/*",
    "https://brave.com/*",
    "https://api.aladhan.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newly@clovince",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
